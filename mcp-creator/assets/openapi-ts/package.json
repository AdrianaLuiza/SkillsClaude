{
  "name": "openapi-mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:stdio": "esbuild src/stdio.ts --bundle --platform=node --format=esm --target=node18 --outfile=mcpb/server/index.js",
    "local": "npm run build:stdio && node mcpb/server/index.js",
    "pack": "npm run build:stdio && npx -y @anthropic-ai/mcpb@2.1.2 pack mcpb openapi-mcp.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "wrangler": "4.132.0",
    "esbuild": "0.28.2"
  }
}